                        .erp-title {
                            font-size: 20px;
                            font-family: Moul;
                            padding-bottom: 3px;
                            font-weight: bold;
                        }
                        .erp-text{
                            font-size: 11px;
                            font-family: Battambang;
                            padding-bottom: 3px;
                        }
                        .erp-title-en {
                            font-size : 18px;

                        }
                        .erp-khmer-title {
