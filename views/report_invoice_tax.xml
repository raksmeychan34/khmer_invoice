                                        <!--<t>Address: 20AB Corner Preah Norodom Blvd and St.118 Sangkat Phsar Chas, Khan Daun Penh, Phnom Penh, Cambodia</t>-->
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div style="text-align: center;">
                                    <!--<img class="img img-responsive" t-att-src="'/erp_report_templates/static/img/aba_qr_code.png'" height="185" width="185"/>-->
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-9">
                                <div class="erp-text">
                                    <div>
                                        <b>CIMB Bank: </b><br/>
                                        <t>Bank Name: CIMB Bank</t><br/>
