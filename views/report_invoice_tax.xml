                                </div>
                                <div class="row">
                                    <div class="col-4">
                                        <div class="erp-text">សារអេឡិចត្រូនិច/Email</div>
                                    </div>
                                    <div class="col-8">
                                        <div class="erp-text">
                                            : <span t-esc="o.partner_id.email"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4">
                                        <div class="erp-text">លេខអត្តសញ្ញាណកម្ម អតប (VAT TIN)</div>
