                                        <!--<b>CIMB Bank: </b><br/>-->
                                        <!--<t>Bank Name: CIMB Bank</t><br/>-->
                                        <!--<t>Account Name: <span t-field="o.company_id.name"/></t><br/>-->
                                        <!--<t>Account Number: 1010-125-00000-7445</t><br/>-->
