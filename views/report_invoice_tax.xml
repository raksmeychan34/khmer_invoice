                                        <div class="erp-text">
                                            : <span t-esc="o.attend_id.name"/>
                                        </div>
                                    </div>
                                </div>
                                -->

                            </div>

                            <div class="col-5">
                                <div class="row">
                                    <div class="col-5">
                                        <div class="erp-text">លេខវិក្កយបត្រ/No</div>
                                    </div>
