                            <div name="company_address" class="float-left mb6">
                                <ul class="list-unstyled erp-text">
                                    <li style="font-family: 'Battambang'; font-size:13px;" t-if="company.vat">លេខអត្តសញ្ញាណកម្ម អតប (VAT TIN): <strong><span t-field="company.vat"/></strong></li>
                                    <!-- <li style="font-family: 'Battambang'; font-size:12px;" t-if="company.khmer_address">អាស័យដ្ឋាន: <span t-field="company.khmer_address"/></li> -->
                                    <li style="font-family: 'Battambang'; font-size:13px;">Address:
                                        <span t-if="company.street" t-esc="company.street"/>,
                                        <span t-if="company.city" t-esc="company.city"/>
                                        <!--<span t-if="company.country_id" t-esc="company.country_id.name"/>-->
                                    </li>
                                    <li style="font-size:13px;">ទូរស័ព្ទលេខ: <span class="" t-field="company.phone"/> / Telephone No: (855) 16 928 929</li>
                                    <li style="font-size:13px;">សារអេឡិចត្រូនិច (E-mail): <span class="" t-field="company.email"/></li>
                                </ul>
                            </div>
                        </div>
                        <!--<div class="col-2 mb2">-->
                        <!--    <span/>-->
                        <!--</div>-->
