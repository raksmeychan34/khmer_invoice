                                    </th>
                                    <th class="erp-text text-end erp-border">
                                        <span t-esc="(o.amount_total * o.exchange_rate)" t-options="{'widget': 'monetary', 'display_currency': o.khr_currency_id}"/>
                                    </th>
                                </tr>
                                -->
                            </tbody>
                        </table>

                        <!-- Bank Information-->
                        <div class="row" t-if="o.narration">
                            <div class="col-10 erp-text">
                                <strong>សម្គាល់/Note:</strong><br/>
