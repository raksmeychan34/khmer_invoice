<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_kh" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kh</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Khmer Invoice" name="khmer_invoice">
                    <block title="Khmer Invoice" id="kh_invoice_settings">
                        <setting id="kh_invoice_default_logo_setting"
                                 string="Default Invoice Logo"
                                 help="Used on the Tax Invoice / Commercial Invoice reports only when this company's Contact record has no logo set">
                            <field name="kh_invoice_default_logo" widget="image" class="oe_avatar" options="{'size': [0, 100]}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>